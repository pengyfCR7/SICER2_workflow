import json
import shlex
import sys
from pathlib import Path

try:
    import tomllib
except ModuleNotFoundError:
    import tomli as tomllib


WORKFLOW_DIR = Path(workflow.basedir)
sys.path.insert(0, str(WORKFLOW_DIR / "lib"))
from workflow_io import (
    load_contrasts,
    load_samples,
    validate_contrast_controls,
    validate_parameters,
    validate_tair10_nuclear_chrom_sizes,
)


shell.executable("/bin/bash")
shell.prefix("set -euo pipefail; ")

if "toml" not in config:
    raise ValueError("Run with --config toml=/path/to/config.toml")

CONFIG_PATH = Path(config["toml"]).resolve()
with CONFIG_PATH.open("rb") as handle:
    CFG = tomllib.load(handle)


def config_path(value):
    path = Path(value).expanduser()
    if not path.is_absolute():
        path = Path.cwd() / path
    return str(path.resolve())


def checked_extra(text, blocked):
    tokens = shlex.split(text or "")
    for token in tokens:
        flag = token.split("=", 1)[0]
        if flag in blocked:
            raise ValueError(f"Managed SICER2 option cannot be repeated in extra: {flag}")
    return " ".join(shlex.quote(token) for token in tokens)


SAMPLES_PATH = config_path(CFG["inputs"]["samples"])
CONTRASTS_PATH = config_path(CFG["inputs"]["contrasts"])
RESULT_DIR = Path(CFG["output"].get("result_dir", "results"))
CALL_CFG = CFG["sicer2_call"]
DIFF_CFG = CFG["sicer2_diff"]
COMMANDS = CFG["commands"]
THREADS = int(CFG.get("resources", {}).get("sicer2_threads", 5))
CHROM_SIZES = config_path(CALL_CFG["chrom_sizes"])

validate_parameters(CALL_CFG, DIFF_CFG)
validate_tair10_nuclear_chrom_sizes(CHROM_SIZES)
SAMPLE_INFO = load_samples(SAMPLES_PATH)
GROUPS = SAMPLE_INFO["groups"]
CONTRAST_INFO = load_contrasts(CONTRASTS_PATH, GROUPS)
CONTRASTS = list(CONTRAST_INFO)
validate_contrast_controls(CONTRAST_INFO, SAMPLE_INFO["group_controls"])

GROUPS_WITH_CONTROL = [group for group in GROUPS if SAMPLE_INFO["group_controls"][group]]
CONTRASTS_WITH_CONTROL = [
    name for name in CONTRASTS
    if SAMPLE_INFO["group_controls"][CONTRAST_INFO[name]["test"]]
]

WORK_DIR = RESULT_DIR / ".work"
SICER_DIR = RESULT_DIR / "sicer2"
DIFF_DIR = RESULT_DIR / "sicer2_diff"
LOG_DIR = RESULT_DIR / "logs"

POOL_SCRIPT = WORKFLOW_DIR / "scripts/pool_se_bams.py"
RUN_SCRIPT = WORKFLOW_DIR / "scripts/run_sicer2.py"
MANIFEST_SCRIPT = WORKFLOW_DIR / "scripts/build_manifest.py"

BLOCKED_CALL = {
    "--treatment_file", "-t", "--control_file", "-c", "--species", "-s",
    "--redundancy_threshold", "-rt", "--window_size", "-w", "--fragment_size", "-f",
    "--effective_genome_fraction", "-egf", "--false_discovery_rate", "-fdr",
    "--output_directory", "-o", "--gap_size", "-g", "--cpu", "-cpu",
    "--chrom-sizes",
}
BLOCKED_DIFF = BLOCKED_CALL | {"--false_discovery_rate_df", "-fdr_df", "--min-fold-change"}
CALL_EXTRA = checked_extra(CALL_CFG.get("extra", ""), BLOCKED_CALL)
DIFF_EXTRA = checked_extra(DIFF_CFG.get("extra", ""), BLOCKED_DIFF)


def pooled_treatment(group):
    return str(WORK_DIR / "pooled" / f"{group}.treatment.bed")


def pooled_control(group):
    return str(WORK_DIR / "pooled" / f"{group}.control.bed")


def contrast_groups(name):
    item = CONTRAST_INFO[name]
    return item["test"], item["reference"]


def manifest_spec():
    spec = {
        "sicer2_python": COMMANDS["sicer2_python"],
        "sicer2_module": CFG.get("software", {}).get("sicer2_module", "unknown"),
        "call_parameters": dict(CALL_CFG),
        "diff_parameters": dict(DIFF_CFG),
        "groups": [],
        "contrasts": [],
    }
    for group in GROUPS:
        spec["groups"].append(
            {
                "group": group,
                "treatment_files": SAMPLE_INFO["group_treatments"][group],
                "control_files": SAMPLE_INFO["group_controls"][group],
                "result_files": {
                    "islands": str(SICER_DIR / group / f"{group}.islands.bed"),
                    "summary": str(SICER_DIR / group / f"{group}.islands.summary.tsv"),
                },
            }
        )
    for name, item in CONTRAST_INFO.items():
        test = item["test"]
        reference = item["reference"]
        spec["contrasts"].append(
            {
                **item,
                "test_treatment_files": SAMPLE_INFO["group_treatments"][test],
                "reference_treatment_files": SAMPLE_INFO["group_treatments"][reference],
                "test_control_files": SAMPLE_INFO["group_controls"][test],
                "reference_control_files": SAMPLE_INFO["group_controls"][reference],
                "result_files": {
                    "all": str(DIFF_DIR / name / f"{name}.all_islands.tsv"),
                    "increased_fdr": str(DIFF_DIR / name / f"{name}.increased.fdr.tsv"),
                    "decreased_fdr": str(DIFF_DIR / name / f"{name}.decreased.fdr.tsv"),
                    "increased_filtered": str(DIFF_DIR / name / f"{name}.increased.filtered.tsv"),
                    "decreased_filtered": str(DIFF_DIR / name / f"{name}.decreased.filtered.tsv"),
                },
            }
        )
    return spec


MANIFEST_SPEC = WORK_DIR / "manifest_spec.json"
MANIFEST_SPEC.parent.mkdir(parents=True, exist_ok=True)
manifest_text = json.dumps(manifest_spec(), indent=2) + "\n"
if not MANIFEST_SPEC.exists() or MANIFEST_SPEC.read_text(encoding="utf-8") != manifest_text:
    MANIFEST_SPEC.write_text(manifest_text, encoding="utf-8")


rule all:
    input:
        expand(str(SICER_DIR / "{group}/{group}.islands.bed"), group=GROUPS),
        expand(str(SICER_DIR / "{group}/{group}.islands.summary.tsv"), group=GROUPS),
        expand(str(DIFF_DIR / "{contrast}/{contrast}.all_islands.tsv"), contrast=CONTRASTS),
        expand(str(DIFF_DIR / "{contrast}/{contrast}.increased.fdr.tsv"), contrast=CONTRASTS),
        expand(str(DIFF_DIR / "{contrast}/{contrast}.decreased.fdr.tsv"), contrast=CONTRASTS),
        expand(str(DIFF_DIR / "{contrast}/{contrast}.increased.filtered.tsv"), contrast=CONTRASTS),
        expand(str(DIFF_DIR / "{contrast}/{contrast}.decreased.filtered.tsv"), contrast=CONTRASTS),
        str(RESULT_DIR / "run_manifest.tsv")


include: "rules/sicer2.smk"
