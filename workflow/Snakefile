import sys
from pathlib import Path

try:
    import tomllib
except ModuleNotFoundError:
    import tomli as tomllib


WORKFLOW_DIR = Path(workflow.basedir)
sys.path.insert(0, str(WORKFLOW_DIR / "lib"))
from workflow_io import load_contrasts, load_samples


shell.executable("/bin/bash")
shell.prefix("set -euo pipefail; ")

if "toml" not in config:
    raise ValueError("Run with --config toml=/path/to/config.toml")

with Path(config["toml"]).resolve().open("rb") as handle:
    CFG = tomllib.load(handle)


def full_path(path):
    path = Path(path).expanduser()
    return str((Path.cwd() / path).resolve() if not path.is_absolute() else path.resolve())


SAMPLES = load_samples(full_path(CFG["inputs"]["samples"]))
GROUPS = SAMPLES["group"].drop_duplicates().tolist()

GROUP_TREATMENTS = {
    group: rows["treatment_bam"].tolist()
    for group, rows in SAMPLES.groupby("group", sort=False)
}
GROUP_CONTROLS = {
    group: rows.loc[rows["control_bam"].ne(""), "control_bam"].drop_duplicates().tolist()
    for group, rows in SAMPLES.groupby("group", sort=False)
}

CONTRAST_TABLE = load_contrasts(
    full_path(CFG["inputs"]["contrasts"]), GROUPS
).set_index("contrast")
CONTRASTS = CONTRAST_TABLE.index.tolist()

RESULT_DIR = Path(CFG["output"].get("result_dir", "results"))
WORK_DIR = RESULT_DIR / ".work"
LOG_DIR = RESULT_DIR / "logs"
CALL_CFG = CFG["sicer2_call"]
DIFF_CFG = CFG["sicer2_diff"]
COMMANDS = CFG["commands"]
THREADS = int(CFG.get("resources", {}).get("sicer2_threads", 5))
CHROM_SIZES = full_path(CALL_CFG["chrom_sizes"])

POOL_SCRIPT = WORKFLOW_DIR / "scripts/pool_se_bams.py"
RUN_SCRIPT = WORKFLOW_DIR / "scripts/run_sicer2.py"


def treatment_bed(group):
    return str(WORK_DIR / "pooled" / f"{group}.treatment.bed")


def control_bed(group):
    return str(WORK_DIR / "pooled" / f"{group}.control.bed")


rule all:
    input:
        expand(str(RESULT_DIR / "sicer2/{group}"), group=GROUPS),
        expand(str(RESULT_DIR / "sicer2_diff/{contrast}"), contrast=list(CONTRASTS))


include: "rules/sicer2.smk"
