import sys
from pathlib import Path

import pandas as pd

try:
    import tomllib
except ModuleNotFoundError:
    import tomli as tomllib


WORKFLOW_DIR = Path(workflow.basedir)
sys.path.insert(0, str(WORKFLOW_DIR / "utils"))
from samples import load_samples


shell.executable("/bin/bash")
shell.prefix("set -euo pipefail; ")

if "toml" not in config:
    raise ValueError("Run with --config toml=/path/to/config.toml")

with open(config["toml"], "rb") as handle:
    CFG = tomllib.load(handle)

SAMPLES = load_samples(CFG["inputs"]["samples"])
GROUPS = SAMPLES["group"].drop_duplicates().tolist()

GROUP_TREATMENTS = {
    group: rows["treatment_bam"].tolist()
    for group, rows in SAMPLES.groupby("group", sort=False)
}
GROUP_CONTROLS = {
    group: rows.loc[rows["control_bam"].ne(""), "control_bam"].drop_duplicates().tolist()
    for group, rows in SAMPLES.groupby("group", sort=False)
}

CONTRAST_TABLE = pd.read_csv(
    CFG["inputs"]["contrasts"], sep="\t", dtype=str
).fillna("").set_index("contrast")
CONTRASTS = CONTRAST_TABLE.index.tolist()

RESULT_DIR = Path(CFG["output"].get("result_dir", "results"))
WORK_DIR = RESULT_DIR / ".work"
LOG_DIR = RESULT_DIR / "logs"
CALL_CFG = CFG["sicer2_call"]
DIFF_CFG = CFG["sicer2_diff"]
COMMANDS = CFG["commands"]
THREADS = int(CFG.get("resources", {}).get("sicer2_threads", 5))
CHROM_SIZES = CALL_CFG["chrom_sizes"]

POOL_SCRIPT = WORKFLOW_DIR / "scripts/pool_se_bams.py"
RUN_SCRIPT = WORKFLOW_DIR / "scripts/run_sicer2.py"


TREATMENT_BEDS = {
    group: str(WORK_DIR / f"pooled/{group}.treatment.bed") for group in GROUPS
}
CONTROL_BEDS = {
    group: str(WORK_DIR / f"pooled/{group}.control.bed") for group in GROUPS
}

CALL_INPUTS = {
    group: {
        "treatment": TREATMENT_BEDS[group],
        **({"control": CONTROL_BEDS[group]} if GROUP_CONTROLS[group] else {}),
    }
    for group in GROUPS
}

DIFF_INPUTS = {}
for contrast, row in CONTRAST_TABLE.iterrows():
    test, reference = row["test"], row["reference"]
    if bool(GROUP_CONTROLS[test]) != bool(GROUP_CONTROLS[reference]):
        raise ValueError(f"Contrast {contrast} mixes groups with and without control")
    DIFF_INPUTS[contrast] = {
        "test": TREATMENT_BEDS[test],
        "reference": TREATMENT_BEDS[reference],
        **(
            {"test_control": CONTROL_BEDS[test], "reference_control": CONTROL_BEDS[reference]}
            if GROUP_CONTROLS[test] else {}
        ),
    }


rule all:
    input:
        expand(str(RESULT_DIR / "sicer2/{group}"), group=GROUPS),
        expand(str(RESULT_DIR / "sicer2_diff/{contrast}"), contrast=list(CONTRASTS))


include: "rules/sicer2.smk"
